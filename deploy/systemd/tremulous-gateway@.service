# WebSocket -> UDP gateway for server %i. Listens on localhost only; nginx (behind
# Cloudflare) is the only thing that talks to it, and it can only reach its own server.
[Unit]
Description=Tremulous websocket gateway %i
After=network.target tremulous-server@%i.service
BindsTo=tremulous-server@%i.service

[Service]
Type=simple
User=trem
Group=trem
ExecStart=/opt/tremulous/venv/bin/websockify 127.0.0.1:2796%i 127.0.0.1:3072%i
Restart=always
RestartSec=2

Nice=5
CPUWeight=40
CPUQuota=40%
MemoryHigh=120M
MemoryMax=180M
TasksMax=128

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @reboot @swap @raw-io
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target

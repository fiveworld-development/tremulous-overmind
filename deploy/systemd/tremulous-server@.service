# Tremulous dedicated server instance %i (1 = Overmind Arena, 2 = Reactor Skirmish)
# UDP only on 127.0.0.1 – players reach it exclusively through the websocket gateway.
[Unit]
Description=Tremulous dedicated server %i
After=network.target

[Service]
Type=simple
User=trem
Group=trem
WorkingDirectory=/opt/tremulous/server
# every (re)start opens on a random map of the rotation (server.cfg: exec startmap.cfg),
# so a restart never shows the same first map again; keeps the last pick on failure
ExecStartPre=/bin/sh -c 'd=/opt/tremulous/servers/%i/gpp; m=$$(grep -E "^[[:space:]]+[A-Za-z0-9_]+[[:space:]]*$$" "$$d/maprotation.cfg" | tr -d " \\t\\r" | shuf -n1); if [ -n "$$m" ]; then echo "map $$m" > "$$d/startmap.cfg"; fi; true'
ExecStart=/opt/tremulous/server/tremded \
    +set dedicated 1 \
    +set net_ip 127.0.0.1 +set net_ip6 ::1 +set net_enabled 1 \
    +set net_port 307%i0 \
    +set fs_basepath /opt/tremulous/server \
    +set fs_homepath /opt/tremulous/servers/%i \
    +set com_hunkmegs 192 \
    +exec server.cfg
Restart=always
RestartSec=3

# resources: the host has 2 cores and runs near 90 % CPU pressure. A game server
# that waits for CPU misses frames, which players see as freezes. Each instance
# needs ~30 % of a core, so it gets priority but is capped at 70 %.
Nice=-5
CPUWeight=400
CPUQuota=70%
IOWeight=40
# 192 MB hunk: nexus6 with 40 slots failed Hunk_Alloc at 128 (pages are only resident once used)
MemoryHigh=320M
MemoryMax=420M
TasksMax=32

# sandbox
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/tremulous/servers/%i
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @debug @cpu-emulation @obsolete @reboot @swap @raw-io
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0077

[Install]
WantedBy=multi-user.target

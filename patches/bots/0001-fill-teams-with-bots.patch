+/**
+ * Human navigation 
+ * @param self
+ */
+void BotNavigateHuman( gentity_t *self ){
+	//If we are tired, stop, crouch and wait...
+	if(self->client->ps.stats[ STAT_STAMINA ] < 100)
+	{
+		BotStop( self );
+		BotCrouch( self );
+		self->bot->timer.foundPath += 3000;
+	}
+}

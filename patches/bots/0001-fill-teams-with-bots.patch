-void SnapVectorNormal( vec3_t v, vec3_t normal )
-{
-  int i;
-
-  for( i = 0 ; i < 3 ; i++ )
-  {
-    if( v[ i ] >= 0 )
-      v[ i ] = (int)( v[ i ] + ( normal[ i ] <= 0 ? 0 : 1 ) );

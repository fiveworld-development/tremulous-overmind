-  if( ( pm->ps->stats[ STAT_TEAM ] == TEAM_HUMANS ) &&
-      ( pm->ps->stats[ STAT_STAMINA ] < STAMINA_SLOW_LEVEL + STAMINA_JUMP_TAKE ) )
-    return qfalse;
-
-  //no bunny hopping off a dodge
-  if( pm->ps->stats[ STAT_TEAM ] == TEAM_HUMANS && 

-
-    if( minDistance <= CREEP_BASESIZE )
-    {
-      if( !self->client )
-        self->parentNode = closestSpawn;
-      return qtrue;
-    }
-    else
-      return qfalse;
-  }
-
-  if( self->client )
-    return qfalse;
-
-  //if we haven't returned by now then we must already have a valid parent
-  return qtrue;
-}

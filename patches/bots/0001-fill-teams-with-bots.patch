+static void Svcmd_TeamWin_f( void )
+{
+  // this is largely made redundant by admitdefeat <team>
+  char cmd[ 6 ];
+  trap_Argv( 0, cmd, sizeof( cmd ) );
+
+  switch( G_TeamFromString( cmd ) )
+  {
+    case TEAM_ALIENS:
+      G_BaseSelfDestruct( TEAM_HUMANS );
+      break;
+
+    case TEAM_HUMANS:
+      G_BaseSelfDestruct( TEAM_ALIENS );
+      break;
+
+    default:
+      return;
+  }
+}

-  if( pm->ps->tauntTimer > 0 )
-  {
-    pm->ps->tauntTimer -= pml.msec;
-
-    if( pm->ps->tauntTimer < 0 )
-    {
-      pm->ps->tauntTimer = 0;
-    }

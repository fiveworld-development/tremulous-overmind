+  trace_t trace;
+
+  trap_Trace( &trace, ent1->s.pos.trBase, NULL, NULL, ent2->s.pos.trBase,
+              ent1->s.number, contents );
+
+  return trace.fraction >= 1.0f || trace.entityNum == ent2 - g_entities;
+}

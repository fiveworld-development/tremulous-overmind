-    bNum = BG_Buildable( ent->s.modelindex )->number;
-
-    if( removalCounts[ bNum ] == 0 )
-      totalListItems++;
-
-    G_Damage( ent, NULL, deconner, NULL, NULL, ent->health, 0, MOD_REPLACE );
-
-    removalCounts[ bNum ]++;
-
-    if( nums )
-      Q_strcat( nums, nsize, va( " %d", (int)(ent - g_entities) ) );
-
-    G_FreeEntity( ent );

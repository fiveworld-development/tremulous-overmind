+						rank += 10; break;
+					default: break;
+				}
+			break;
+			case WP_MASS_DRIVER: 
+				switch(target->client->pers.classSelection) {
+					case PCL_ALIEN_BUILDER0:
+					case PCL_ALIEN_BUILDER0_UPG:
+					case PCL_ALIEN_LEVEL0:

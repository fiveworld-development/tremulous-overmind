-
-  if( buildable > BA_NONE )
-  {
-    if( ent->client->ps.stats[ STAT_MISC ] > 0 )
-    {
-      G_AddEvent( ent, EV_BUILD_DELAY, ent->client->ps.clientNum );
-      return;
-    }
-
-    if( G_BuildIfValid( ent, buildable ) )

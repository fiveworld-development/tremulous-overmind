+					case WP_LUCIFER_CANNON:
+						rank += 30; break;
+					default: break;
+				}
+			break;
+			default: break;
+		}
+		if(BS) {
+			rank -= 10;
+		} else if(Naked) {
+			rank += 30;
+		}
+	}
+	return (int)rank;
+}

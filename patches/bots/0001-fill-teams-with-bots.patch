-  /*TA: for some reason the Q3 VM goes apeshit when x = 1.0
-        and y > 1.0. Curiously this doesn't happen with gcc
-        hence this hack*/
-  if( x == 1.0 )
-    return x;
-
-  GET_FLOAT_WORD( hx, x );
-  GET_FLOAT_WORD( hy, y );
-  ix = hx & 0x7fffffff;
-  iy = hy & 0x7fffffff;
-

+static qboolean admin_higher_admin( g_admin_admin_t *a, g_admin_admin_t *b )
+{
+  qboolean perm;
+
+  if( !b )
+    return qtrue;
+
+  if( admin_permission( b->flags, ADMF_IMMUTABLE, &perm ) )
+    return !perm;
+
+  return b->level <= ( a ? a->level : 0 );
+}

-  zap_t *zap;
-
-  for( i = 0; i < MAX_ZAPS; i++ )
-  {
-    zap = &zaps[ i ];
-    if( !zap->used )
-      continue;
-
-    // the disappearance of the creator or the first target destroys the whole zap effect
-    if( zap->creator == player || zap->targets[ 0 ] == player )

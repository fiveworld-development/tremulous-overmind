-      else if( pm->cmd.upmove >= 0 )
-        pm->ps->pm_flags &= ~PMF_CROUCH_HELD;
-    }
-    else
-    {
-      if( pm->cmd.upmove < 0 )
-        pm->ps->stats[ STAT_STATE ] |= SS_WALLCLIMBING;

-qboolean G_admin_permission( gentity_t *ent, const char *flag )
-{
-  qboolean perm;
-  g_admin_admin_t *a;
-  g_admin_level_t *l;
-
-  // console always wins
-  if( !ent )
-    return qtrue;
-
-  if( ( a = ent->client->pers.admin ) )
-  {
-    if( admin_permission( a->flags, flag, &perm ) )
-      return perm;
-
-    l = G_admin_level( a->level );
-  }
-  else
-    l = G_admin_level( 0 );
-
-  if( l )
-    return admin_permission( l->flags, flag, &perm ) && perm;
-
-  return qfalse;
-}

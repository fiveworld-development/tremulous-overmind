-void SP_target_delay( gentity_t *ent )
-{
-  // check delay for backwards compatability
-  if( !G_SpawnFloat( "delay", "0", &ent->wait ) )
-    G_SpawnFloat( "wait", "1", &ent->wait );
-
-  if( !ent->wait )

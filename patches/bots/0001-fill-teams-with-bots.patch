-      self->timestamp = level.time;
-      if( self->dcc )
-        G_SelectiveRadiusDamage( self->s.pos.trBase, self,
-                                 REACTOR_ATTACK_DCC_DAMAGE,
-                                 REACTOR_ATTACK_DCC_RANGE, self,
-                                 MOD_REACTOR, TEAM_HUMANS );
-      else
-        G_SelectiveRadiusDamage( self->s.pos.trBase, self,
-                                 REACTOR_ATTACK_DAMAGE,
-                                 REACTOR_ATTACK_RANGE, self,
-                                 MOD_REACTOR, TEAM_HUMANS );

+/*
+===============
+BG_InitClassConfigs
+===============
+*/
+void BG_InitClassConfigs( void )
+{
+  int           i;
+  classConfig_t *cc;
+
+  for( i = PCL_NONE; i < PCL_NUM_CLASSES; i++ )
+  {
+    cc = BG_ClassConfig( i );
+
+    BG_ParseClassFile( va( "configs/classes/%s.cfg",
+                           BG_Class( i )->name ), cc );
+  }
+}

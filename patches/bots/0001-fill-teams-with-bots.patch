-static void PM_CheckCharge( void )
-{
-  if( pm->ps->weapon != WP_ALEVEL4 )
-    return;
-
-  if( pm->cmd.buttons & BUTTON_ATTACK2 &&
-      !( pm->ps->stats[ STAT_STATE ] & SS_CHARGING ) )
-  {
-    pm->ps->pm_flags &= ~PMF_CHARGE;
-    return;
-  }
-
-  if( pm->ps->stats[ STAT_MISC ] > 0 )

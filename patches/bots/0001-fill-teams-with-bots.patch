- * @param fmt
- * @param ...
- */
-void QDECL G_Printf( const char *fmt, ... )
-{
-  va_list argptr;
-  char    text[ 1024 ];
-
-  va_start( argptr, fmt );
-  Q_vsnprintf( text, sizeof( text ), fmt, argptr );
-  va_end( argptr );
-
-  trap_Print( text );
-}

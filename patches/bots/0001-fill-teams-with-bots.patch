-void SnapVectorTowards( vec3_t v, vec3_t to )
-{
-  int   i;
-
-  for( i = 0 ; i < 3 ; i++ )
-  {
-    if( v[ i ] >= 0 )
-      v[ i ] = (int)( v[ i ] + ( to[ i ] <= v[ i ] ? 0 : 1 ) );
-    else
-      v[ i ] = (int)( v[ i ] + ( to[ i ] <= v[ i ] ? -1 : 0 ) );
-  }
-}

+void G_admin_cleanup( void )
+{
+  g_admin_level_t *l;
+  g_admin_admin_t *a;
+  g_admin_ban_t *b;
+  g_admin_command_t *c;
+  void *n;
+
+  for( l = g_admin_levels; l; l = n )
+  {
+    n = l->next;
+    BG_Free( l );
+  }
+  g_admin_levels = NULL;
+  for( a = g_admin_admins; a; a = n )
+  {
+    n = a->next;
+    BG_Free( a );
+  }
+  g_admin_admins = NULL;
+  for( b = g_admin_bans; b; b = n )
+  {
+    n = b->next;
+    BG_Free( b );
+  }
+  g_admin_bans = NULL;
+  for( c = g_admin_commands; c; c = n )
+  {
+    n = c->next;
+    BG_Free( c );
+  }
+  g_admin_commands = NULL;
+  BG_DefragmentMemory( );
+}

-  pm->ps->weaponstate = WEAPON_DROPPING;
-  pm->ps->weaponTime += 200;
-  pm->ps->persistant[ PERS_NEWWEAPON ] = weapon;
-
-  //reset build weapon
-  pm->ps->stats[ STAT_BUILDABLE ] = BA_NONE;

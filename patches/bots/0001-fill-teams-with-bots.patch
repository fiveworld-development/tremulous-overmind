-  gclient_t *ca, *cb;
-
-  ca = &level.clients[ *(int *)a ];
-  cb = &level.clients[ *(int *)b ];
-
-  // then sort by score
-  if( ca->ps.persistant[ PERS_SCORE ] > cb->ps.persistant[ PERS_SCORE ] )

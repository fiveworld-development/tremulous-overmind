-      if( i == 0 )
-      {
-        // 
-      }
-      else if( seen ) // :: has been seen already
-      {
-        b[ after * 2 ] = num >> 8;
-        b[ after * 2 + 1 ] = num & 0xff;
-        after++;
-      }
-      else
-      {
-        a[ before * 2 ] = num >> 8;
-        a[ before * 2 + 1 ] = num & 0xff;
-        before++;
-      }
-      if( !str[ i ] )
-        break;
-      if( str[ i ] != ':' || before + after == 8 )
-        break;
-      if( str[ i + 1 ] == ':' )
-      {
-        // ::: or multiple ::
-        if( seen || str[ i + 2 ] == ':' )

-/*
-=============
-G_NewString
-
-Builds a copy of the string, translating \n to real linefeeds
-so message texts can be multi-line
-=============
-*/
-char *G_NewString( const char *string )
-{
-  char  *newb, *new_p;
-  int   i,l;
-
-  l = strlen( string ) + 1;
-
-  newb = BG_Alloc( l );
-
-  new_p = newb;
-
-  // turn \n into a real linefeed
-  for( i = 0 ; i < l ; i++ )
-  {
-    if( string[ i ] == '\\' && i < l - 1 )
-    {
-      i++;
-      if( string[ i ] == 'n' )
-        *new_p++ = '\n';
-      else
-        *new_p++ = '\\';
-    }
-    else
-      *new_p++ = string[ i ];
-  }
-
-  return newb;
-}

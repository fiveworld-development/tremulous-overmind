-    G_SanitiseString( testname, name, sizeof( name ) );
-
-  if( vic )
-    a = vic->client->pers.admin;
-  else if( !a )
-  {
-    g_admin_admin_t *wa;
-    int             matches = 0;
-
-    for( wa = g_admin_admins; wa && matches < 2; wa = wa->next )
-    {
-      G_SanitiseString( wa->name, testname, sizeof( testname ) );

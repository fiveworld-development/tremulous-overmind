-/*
-==============
- G_UnlaggedClear
-
- Mark all unlaggedHist[] markers for this client invalid.  Useful for
- preventing teleporting and death.
-==============
-*/
-void G_UnlaggedClear( gentity_t *ent )
-{
-  int i;
-
-  for( i = 0; i < MAX_UNLAGGED_MARKERS; i++ )
-    ent->client->unlaggedHist[ i ].used = qfalse;
-}

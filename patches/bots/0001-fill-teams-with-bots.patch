-
-    memcpy( line + len, printArg, tlen );
-    len += tlen;
-
-    if( len == MAX_STRING_CHARS - 1 )
-      break;
-
-    if( i != c - 1 )
-    {
-      line[ len ] = ' ';
-      len++;
-    }
-  }
-
-  line[ len ] = 0;
-
-  return line;

-static void PM_DeadMove( void )
-{
-  float forward;
-
-  if( !pml.walking )
-    return;
-
-  // extra friction
-
-  forward = VectorLength( pm->ps->velocity );
-  forward -= 20;
-
-  if( forward <= 0 )
-    VectorClear( pm->ps->velocity );
-  else
-  {
-    VectorNormalize( pm->ps->velocity );
-    VectorScale( pm->ps->velocity, forward, pm->ps->velocity );
-  }

-static gentity_t *G_FindBuildable( buildable_t buildable )
-{
-  int       i;
-  gentity_t *ent;
-
-  for( i = MAX_CLIENTS, ent = g_entities + i;
-       i < level.num_entities; i++, ent++ )
-  {
-    if( ent->s.eType != ET_BUILDABLE )
-      continue;

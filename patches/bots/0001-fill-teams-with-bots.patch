-  vec3_t    range = { REACTOR_ATTACK_RANGE,
-                      REACTOR_ATTACK_RANGE,
-                      REACTOR_ATTACK_RANGE };
-  vec3_t    dccrange = { REACTOR_ATTACK_DCC_RANGE,
-                         REACTOR_ATTACK_DCC_RANGE,
-                         REACTOR_ATTACK_DCC_RANGE };

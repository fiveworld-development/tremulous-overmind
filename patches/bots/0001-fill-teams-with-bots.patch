+int G_FindDCC( gentity_t *self )
+{
+  int       i;
+  gentity_t *ent;
+  int       distance = 0;
+  vec3_t    temp_v;
+  int       foundDCC = 0;
+
+  if( self->buildableTeam != TEAM_HUMANS )
+    return 0;
+
+  //iterate through entities
+  for( i = MAX_CLIENTS, ent = g_entities + i; i < level.num_entities; i++, ent++ )

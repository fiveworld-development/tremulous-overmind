+/**
+ * Skill for a new bot, 1 (sloppy) .. 10 (sharp).
+ * g_bot_skill 1-10 pins every bot to that value. 0 (default) rolls a base skill
+ * per map and spreads each bot +-2 around it, so one round feels like a casual
+ * lobby and the next like a sweaty one, and no two bots play quite alike.
+ * @return int
+ */
+int G_BotPickSkill( void ) {
+	static int mapStart = -1;
+	static int base = 5;
+	int skill;
+
+	if( g_bot_skill.integer >= 1 && g_bot_skill.integer <= 10 ) {
+		return g_bot_skill.integer;
+	}
+	if( mapStart != level.startTime ) {
+		mapStart = level.startTime;
+		base = G_Rand_Range( 1, 6 ); // 1..5: real players should usually out-aim them
+	}
+	skill = base + G_Rand_Range( -2, 3 ); // -2..+2
+	if( skill < 1 ) skill = 1;
+	if( skill > 10 ) skill = 10;
+	return skill;
+}
+/**
+ * Real (non-bot) players that are connected or connecting
+ * @return int
+ */

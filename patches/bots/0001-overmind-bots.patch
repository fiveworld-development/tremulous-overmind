+	for( i = 0; i < level.maxclients; i++ ) {
+		if( level.clients[ i ].pers.connected != CON_DISCONNECTED && !( g_entities[ i ].r.svFlags & SVF_BOT ) ) {
+			n++;
+		}
+	}
+	return n;
+}

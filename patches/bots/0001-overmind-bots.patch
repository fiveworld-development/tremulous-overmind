+	int aliens_add_rm, humans_add_rm;
+
+	// g_bot_fillTeam N: the server always looks like an N vs N match with exactly one
+	// seat open. Teams are topped up to N with bots, but bots plus real players (in a
+	// team or spectating) never exceed 2N-1, so whoever connects next finds a seat and
+	// a bot makes room as they join a team.
+	if( g_bot_fillTeam.integer > 0 ) {
+		int seats = 2 * g_bot_fillTeam.integer - 1 - G_HumanClients( );
+		int shortSide = ( level.startTime / 1000 ) & 1; // which team gets the open seat, fixed per map
+		aliens = g_bot_fillTeam.integer - alien_players;
+		humans = g_bot_fillTeam.integer - human_players;
+		if( aliens < 0 ) aliens = 0;
+		if( humans < 0 ) humans = 0;
+		if( seats < 0 ) seats = 0;
+		while( aliens + humans > seats ) {
+			if( aliens > humans || ( aliens == humans && shortSide ) ) aliens--;
+			else humans--;
+		}
+	}
+	aliens_add_rm = aliens - level.alienBots;
+	humans_add_rm = humans - level.humanBots;
 	

+/**
+ * Overmind: turn a bot's view towards an angle at a human-like speed instead of
+ * snapping to it in one server frame. degPerSec is the most it may turn per second.
+ * @param self [gentity_t] a BOT
+ * @param axis PITCH or YAW
+ * @param target wanted view angle in degrees
+ * @param degPerSec turn speed limit
+ */
+void botTurnTowards( gentity_t *self, int axis, float target, float degPerSec ) {
+	float current = SHORT2ANGLE( self->client->ps.delta_angles[ axis ] );
+	float diff = AngleNormalize180( target - current );
+	int msec = level.time - level.previousTime;
+	float step;
+
+	if( msec <= 0 || msec > 200 ) msec = 50;
+	step = degPerSec * msec / 1000.0f;
+	if( diff > step ) diff = step;
+	else if( diff < -step ) diff = -step;
+	self->client->ps.delta_angles[ axis ] = ANGLE2SHORT( current + diff );
+}
+/**
+ * Overmind: aiming turn speed for a bot, 1 (sloppy) .. 10 (sharp): ~115..340 deg/s
+ */
+float botAimTurnSpeed( gentity_t *self ) {
+	int skill = ( self->bot && self->bot->skill > 0 ) ? self->bot->skill : 5;
+	return 90.0f + 25.0f * skill;
+}

+/*
+============
+Bot base building (Tremulous Overmind)
+
+The P-Bot AI fights, evolves and buys but never builds, so bases stayed as the map
+spawned them. Every few seconds each team's bots grow their base the way a human
+builder would: pick the next structure from a build order, look for a spot near
+the base and run it through the normal player build checks (build points, power,
+creep, room, permissions) and G_Build(), so it rises with the usual construction
+time and shows up in the build log under a bot's name.
+============
+*/
+
+typedef struct
+{
+  buildable_t buildable;
+  int         count;     // build until the team has this many
+} botBuildStep_t;
+
+static const botBuildStep_t botHumanPlan[ ] =
+{
+  { BA_H_SPAWN, 2 }, { BA_H_MGTURRET, 2 }, { BA_H_ARMOURY, 1 }, { BA_H_MEDISTAT, 1 },
+  { BA_H_MGTURRET, 4 }, { BA_H_SPAWN, 3 }, { BA_H_DCC, 1 }, { BA_H_TESLAGEN, 2 },
+  { BA_H_MGTURRET, 6 }, { BA_H_TESLAGEN, 4 }, { BA_H_SPAWN, 4 }
+};
+
+static const botBuildStep_t botAlienPlan[ ] =
+{
+  { BA_A_SPAWN, 2 }, { BA_A_ACIDTUBE, 2 }, { BA_A_ACIDTUBE, 4 }, { BA_A_SPAWN, 3 },
+  { BA_A_TRAPPER, 2 }, { BA_A_BOOSTER, 1 }, { BA_A_HIVE, 1 }, { BA_A_ACIDTUBE, 6 },
+  { BA_A_BARRICADE, 2 }, { BA_A_HIVE, 2 }, { BA_A_SPAWN, 4 }
+};
+
+static int G_BotCountBuildables( team_t team, buildable_t buildable, gentity_t **any )
+{
+  int       i, n = 0, seen = 0;
+  gentity_t *ent;
+
+  for( i = MAX_CLIENTS, ent = g_entities + i; i < level.num_entities; i++, ent++ )
+  {
+    if( ent->s.eType != ET_BUILDABLE || ent->buildableTeam != team || ent->health <= 0 )
+      continue;
+    if( ent->s.modelindex == buildable )
+      n++;
+    // reservoir-sample a random team structure to build around
+    if( any && rand( ) % ++seen == 0 )
+      *any = ent;
+  }
+  return n;
+}
+
+static gentity_t *G_BotPickBuilder( team_t team )
+{
+  int       i, seen = 0;
+  gentity_t *ent, *pick = NULL;
+
+  for( i = 0, ent = g_entities; i < level.maxclients; i++, ent++ )
+  {
+    if( !ent->inuse || !ent->client || !( ent->r.svFlags & SVF_BOT ) )
+      continue;
+    if( ent->client->ps.stats[ STAT_TEAM ] != team || ent->health <= 0 ||
+        ent->client->sess.spectatorState != SPECTATOR_NOT )
+      continue;
+    if( rand( ) % ++seen == 0 )
+      pick = ent;
+  }
+  return pick;
+}
+
+/*
+ * Try to place one buildable near "around". The builder's player state is swapped
+ * for a standing builder looking at a random spot, so G_CanBuild() runs exactly as
+ * for a real player standing there; it is restored afterwards.
+ */
+static qboolean G_BotTryBuildAt( gentity_t *builder, buildable_t buildable, gentity_t *around )
+{
+  playerState_t saved;
+  vec3_t        eye, ground, origin, normal, start;
+  trace_t       tr;
+  float         ang, dist;
+  int           attempt;
+  qboolean      built = qfalse;
+  team_t        team = builder->client->ps.stats[ STAT_TEAM ];
+
+  saved = builder->client->ps;
+
+  for( attempt = 0; attempt < 8 && !built; attempt++ )
+  {
+    ang = ( rand( ) % 360 ) * M_PI / 180.0f;
+    dist = 120 + rand( ) % 380;
+    VectorCopy( around->s.origin, start );
+    start[ 2 ] += 48;
+    eye[ 0 ] = start[ 0 ] + cos( ang ) * dist;
+    eye[ 1 ] = start[ 1 ] + sin( ang ) * dist;
+    eye[ 2 ] = start[ 2 ];
+
+    // stay in sight of the base, no building through walls
+    trap_Trace( &tr, start, NULL, NULL, eye, ENTITYNUM_NONE, MASK_PLAYERSOLID );
+    if( tr.fraction < 1.0f || tr.startsolid )
+      continue;
+
+    // stand on the floor there
+    VectorCopy( eye, ground );
+    ground[ 2 ] -= 256;
+    trap_Trace( &tr, eye, NULL, NULL, ground, ENTITYNUM_NONE, MASK_PLAYERSOLID );
+    if( tr.fraction == 1.0f || tr.startsolid || tr.plane.normal[ 2 ] < 0.7f )
+      continue;
+
+    builder->client->ps.origin[ 0 ] = tr.endpos[ 0 ];
+    builder->client->ps.origin[ 1 ] = tr.endpos[ 1 ];
+    builder->client->ps.origin[ 2 ] = tr.endpos[ 2 ] + 40;
+    builder->client->ps.viewangles[ PITCH ] = 0;
+    builder->client->ps.viewangles[ YAW ] = rand( ) % 360;
+    builder->client->ps.viewangles[ ROLL ] = 0;
+    builder->client->ps.stats[ STAT_CLASS ] =
+      ( team == TEAM_ALIENS ) ? PCL_ALIEN_BUILDER0_UPG : PCL_HUMAN;
+    builder->client->ps.stats[ STAT_STATE ] &= ~SS_WALLCLIMBING;
+    builder->client->ps.eFlags &= ~EF_WALLCLIMB;
+
+    if( G_CanBuild( builder, buildable, 0, origin, normal ) == IBE_NONE &&
+        level.numBuildablesForRemoval == 0 )
+    {
+      vec3_t angles;
+
+      VectorSet( angles, 0, builder->client->ps.viewangles[ YAW ], 0 );
+      builder->client->ps = saved;
+      G_Build( builder, buildable, origin, normal, angles );
+      built = qtrue;
+    }
+    level.numBuildablesForRemoval = 0;
+  }
+
+  builder->client->ps = saved;
+  return built;
+}
+
+static void G_BotBuildForTeam( team_t team )
+{
+  const botBuildStep_t *plan;
+  int                  steps, i, stage;
+  gentity_t            *builder, *around = NULL, *core;
+  buildable_t          coreType;
+
+  builder = G_BotPickBuilder( team );
+  if( !builder )
+    return;
+
+  if( team == TEAM_ALIENS )
+  {
+    plan = botAlienPlan;
+    steps = ARRAY_LEN( botAlienPlan );
+    stage = g_alienStage.integer;
+    coreType = BA_A_OVERMIND;
+    core = G_Overmind( );
+  }
+  else
+  {
+    plan = botHumanPlan;
+    steps = ARRAY_LEN( botHumanPlan );
+    stage = g_humanStage.integer;
+    coreType = BA_H_REACTOR;
+    core = G_Reactor( );
+  }
+
+  G_BotCountBuildables( team, BA_NONE, &around );
+  if( !around )
+    return; // nothing left to build around: the team is on its last legs
+
+  // a lost core comes first, like any sane builder would do
+  if( !core )
+  {
+    G_BotTryBuildAt( builder, coreType, around );
+    return;
+  }
+
+  for( i = 0; i < steps; i++ )
+  {
+    if( !BG_BuildableAllowedInStage( plan[ i ].buildable, stage ) ||
+        !BG_BuildableIsAllowed( plan[ i ].buildable ) )
+      continue;
+    if( G_BotCountBuildables( team, plan[ i ].buildable, NULL ) >= plan[ i ].count )
+      continue;
+    // build next to the core most of the time so bases look like bases
+    G_BotTryBuildAt( builder, plan[ i ].buildable, ( rand( ) % 3 ) ? core : around );
+    return;
+  }
+}
+
+/*
+============
+G_BotBaseBuild
+
+Called every frame from G_RunFrame; paces itself like a human builder.
+============
+*/
+void G_BotBaseBuild( void )
+{
+  static int nextBuild[ NUM_TEAMS ];
+  team_t     team;
+
+  if( !g_bot.integer || !g_bot_build.integer || level.intermissiontime )
+    return;
+
+  for( team = TEAM_ALIENS; team <= TEAM_HUMANS; team++ )
+  {
+    if( level.time < nextBuild[ team ] - 60000 )
+      nextBuild[ team ] = 0; // new map
+    if( level.time < nextBuild[ team ] || level.time - level.startTime < 5000 )
+      continue;
+    nextBuild[ team ] = level.time + 6000 + rand( ) % 8000;
+    G_BotBuildForTeam( team );
+  }
+}

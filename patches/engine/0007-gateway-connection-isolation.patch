+/*
+==================
+SV_SameConnection
+
+Is a connect from this address a reconnect of that client? Through the
+websocket gateway only the same connection (port) counts: the qport is chosen
+by the client and would let anyone take over another player's slot.
+==================
+*/
+static bool SV_SameConnection( netadr_t from, client_t *cl, int qport )
+{
+	if ( SV_IsGatewayAddress( from ) )
+		return NET_CompareAdr( from, cl->netchan.remoteAddress );
+	return NET_CompareBaseAdr( from, cl->netchan.remoteAddress )
+		&& ( cl->netchan.qport == qport || from.port == cl->netchan.remoteAddress.port );
+}

+/*
+================
+SV_IsGatewayAddress
+
+Overmind: every player comes in through the local websocket gateway, so all of
+them share 127.0.0.1. The gateway opens one UDP socket per connection, so the
+source port is what tells players apart (the qport is chosen by the client).
+================
+*/
+bool SV_IsGatewayAddress( netadr_t a )
+{
+	return a.type == NA_IP && a.ip[0] == 127;
+}
+
 bool SVC_RateLimitAddress( netadr_t from, int burst, int period )
 {
+	// one bucket per gateway connection instead of one shared by every player
+	if ( SV_IsGatewayAddress( from ) ) {
+		from.ip[1] = ( from.port >> 8 ) & 0xff;
+		from.ip[2] = from.port & 0xff;
+	}
 	leakyBucket_t *bucket = SVC_BucketForAddress( from, burst, period );
 	return SVC_RateLimit( bucket, burst, period );
 }

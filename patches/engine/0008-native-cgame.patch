diff --git a/Makefile b/Makefile
index 043db81..81d1720 100644
--- a/Makefile
+++ b/Makefile
@@ -845,6 +845,12 @@ ifeq ($(PLATFORM),js)
     -s EXPORT_NAME=\"tremulous\" \
     $(OPTIMIZE)
 

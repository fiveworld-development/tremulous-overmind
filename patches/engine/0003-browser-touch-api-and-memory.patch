+#ifdef __EMSCRIPTEN__
+/*
+===============
+Browser input API (Tremulous Overmind)
+
+Called by the page's touch layer. Events go straight into the engine queue, so
+touch play needs no fake DOM events and works without pointer lock.
+===============
+*/
+
+// actions the touch layer can press; they go through the normal key bindings
+static const int overmindActionKeys[] = {
+	'w', 's', 'a', 'd',         // 0-3  move forward / back / left / right
+	K_SPACE, 'c',               // 4-5  jump, crouch (aliens: wallwalk)
+	K_MOUSE1, K_MOUSE2,         // 6-7  fire, alt fire
+	K_ENTER, 'r',               // 8-9  use (armoury, evolve, build menu), reload
+	K_MWHEELUP, K_MWHEELDOWN,   // 10-11 previous / next weapon
+	K_TAB, K_ESCAPE,            // 12-13 scores, menu
+	'm', 'b', 'e'               // 14-16 medkit, buy ammo, deconstruct
+};
+
+extern "C" {
+
+EMSCRIPTEN_KEEPALIVE void Overmind_Action( int action, int down )
+{
+	if( action < 0 || action >= (int)ARRAY_LEN( overmindActionKeys ) )
+		return;
+	Com_QueueEvent( Sys_Milliseconds( ), SE_KEY, overmindActionKeys[ action ], down ? true : false, 0, NULL );
+}
+
+// relative look, in mouse counts (sensitivity applies as for a mouse)
+EMSCRIPTEN_KEEPALIVE void Overmind_Look( int dx, int dy )
+{
+	if( dx || dy )
+		Com_QueueEvent( Sys_Milliseconds( ), SE_MOUSE, dx, dy, 0, NULL );
+}
+
+// absolute menu cursor in window pixels (canvas backing size); -1 releases it
+EMSCRIPTEN_KEEPALIVE void Overmind_Pointer( int x, int y )
+{
+	touchPointerX = x;
+	touchPointerY = y;
+}
+
+// bit 0-3: KEYCATCH_* (console, ui, message, cgame); bit 8: in a game
+EMSCRIPTEN_KEEPALIVE int Overmind_State( void )
+{
+	return Key_GetCatcher( ) | ( clc.state == CA_ACTIVE ? 0x100 : 0 );
+}
+
+// new render size after rotation / resize; the video restart waits until the
+// size has settled, like the desktop does while dragging a window border
+EMSCRIPTEN_KEEPALIVE void Overmind_Resize( int width, int height )
+{
+	if( width < 320 || height < 200 )
+		return;
+	if( cls.glconfig.vidWidth == width && cls.glconfig.vidHeight == height )
+		return;
+	Cvar_SetValue( "r_width", width );
+	Cvar_SetValue( "r_height", height );
+	Cvar_SetValue( "r_customwidth", width );
+	Cvar_SetValue( "r_customheight", height );
+	vidRestartTime = Sys_Milliseconds( ) + 600;
+}
+
+EMSCRIPTEN_KEEPALIVE void Overmind_Command( const char *text )
+{
+	if( !text || !*text )
+		return;
+	Cbuf_AddText( text );
+	Cbuf_AddText( "\n" );
+}
+
+}
+#endif
